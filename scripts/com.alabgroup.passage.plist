<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alabgroup.passage</string>

  <!-- A LaunchAgent, not a LaunchDaemon: it must run inside the logged-in
       user's session, because only that session can hold the microphone
       permission and see the audio devices. -->
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-u</string>
    <string>run.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if it exits for any reason, so a crash mid-service recovers
       without anyone noticing. -->
  <key>KeepAlive</key>
  <true/>

  <!-- Don't hammer the CPU relaunching a service that fails immediately. -->
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>__REPO__/logs/passage.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/logs/passage.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a bare PATH; ffmpeg and friends live in Homebrew. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HF_HUB_DISABLE_XET</key>
    <string>1</string>
  </dict>
</dict>
</plist>
